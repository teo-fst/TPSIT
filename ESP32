#include <WiFi.h>
#include <WebServer.h>
#include <Wire.h>

// --- CONFIGURAZIONE RETE ---
const char* ssid = "Dispenser_IoT";
const char* password = "password123";
WebServer server(80);

// --- CONFIGURAZIONE I2C E PIN ---
const int MEGA_ADDR = 0x08;
const int PIN_WAKE = 4; // Collegato al PIN 2 dell'Arduino MEGA

// --- VARIABILI DI STATO ---
int oreIntervallo = 2;          // Ricevuto da MEGA
unsigned long ultimoPasto = 0;
String statoSistema = "Inizializzazione...";

// --- FUNZIONI DI COMUNICAZIONE ---

void svegliaMega() {
  digitalWrite(PIN_WAKE, LOW); // Invia impulso di risveglio
  delay(20);                   // Piccolo delay per permettere al MEGA di ripartire
  digitalWrite(PIN_WAKE, HIGH);
  delay(100);                  // Attesa stabilizzazione bus I2C
}

void richiediDatiAlMega() {
  svegliaMega();
  Wire.requestFrom(MEGA_ADDR, 1); 
  if (Wire.available()) {
    oreIntervallo = Wire.read();
    statoSistema = "Sincronizzato. Prossimo pasto tra " + String(oreIntervallo) + " ore.";
  }
}

void inviaComandoErogazione() {
  svegliaMega();
  Wire.beginTransmission(MEGA_ADDR);
  Wire.write(1); // Comando "Eroga" (bool true)
  Wire.endTransmission();
  ultimoPasto = millis();
  statoSistema = "Erogazione inviata con successo!";
}

// --- HANDLERS WEB SERVER ---

void handleRoot() {
  String html = "<html><head><meta name='viewport' content='width=device-width, initial-scale=1.0'>";
  html += "<style>body{font-family:sans-serif; text-align:center; padding-top:50px;}";
  html += ".btn{display:inline-block; padding:15px 25px; font-size:18px; cursor:pointer; text-align:center; color:#fff; background-color:#4CAF50; border:none; border-radius:15px; text-decoration:none;}";
  html += "</style></head><body>";
  html += "<h1>Pet Dispenser 2-in-1</h1>";
  html += "<h3>Stato: " + statoSistema + "</h3>";
  html += "<p>Intervallo attuale: " + String(oreIntervallo) + " ore</p>";
  html += "<br><a href='/eroga' class='btn'>EROGA ORA</a>";
  html += "<br><br><a href='/sync'>Sincronizza con Dispenser</a>";
  html += "</body></html>";
  server.send(200, "text/html", html);
}

void handleEroga() {
  inviaComandoErogazione();
  server.sendHeader("Location", "/");
  server.send(303);
}

void handleSync() {
  richiediDatiAlMega();
  server.sendHeader("Location", "/");
  server.send(303);
}

// --- SETUP E LOOP ---

void setup() {
  Serial.begin(115200);
  Wire.begin(); // SDA=21, SCL=22 su ESP32 standard
  
  pinMode(PIN_WAKE, OUTPUT);
  digitalWrite(PIN_WAKE, HIGH); // Pin inattivo (Pull-up)

  // Configurazione Wi-Fi Access Point
  WiFi.softAP(ssid, password);
  Serial.println("AP Avviato. IP: " + WiFi.softAPIP().toString());

  server.on("/", handleRoot);
  server.on("/eroga", handleEroga);
  server.on("/sync", handleSync);
  server.begin();

  // Prima sincronizzazione
  delay(2000); 
  richiediDatiAlMega();
}

void loop() {
  server.handleClient();

  // Controllo automatico del tempo per l'erogazione
  // Calcolo semplificato (millisecondi -> ore)
  // Per i test puoi abbassare questo valore (es. 10000 per 10 secondi)
  unsigned long intervalloMs = (unsigned long)oreIntervallo * 3600000UL; 

  if (millis() - ultimoPasto >= intervalloMs) {
    inviaComandoErogazione();
  }
}
